{
  "name": "equipo/cineapp",
  "type": "project",
  "require": {
    "php": "^8.0",
    "vlucas/phpdotenv": "^5.6",
    "guzzlehttp/guzzle": "^7.8",
    "ramsey/uuid": "^4.9",
    "voku/anti-xss": "^4.1",
    "defuse/php-encryption": "^2.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "App\\Core\\": "core/",
      "App\\Models\\": "Models/",
      "App\\Controllers\\": "Controllers/",
      "App\\Helpers\\": "Helpers/",
      "App\\Services\\": "Services/",
      "App\\Middleware\\": "Middleware/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
