DB_HOST=localhost
DB_PORT=3306
DB_NAME=cineapp
DB_USER=root
DB_PASS=

SESSION_LIFETIME=3600
APP_DEBUG=false
APP_ENV=production

# Clave de cifrado AES-256-GCM para defuse/php-encryption
# Generar con: php -r "require 'vendor/autoload.php'; echo \Defuse\Crypto\Key::createNewRandomKey()->saveToAsciiSafeString();"
APP_KEY=

# Clave HMAC-SHA256 para blind index de emails (min. 32 bytes aleatorios)
# Generar con: php -r "echo bin2hex(random_bytes(32));"
APP_HMAC_KEY=

# API key para autenticar POST /api/v1/contenido (header X-Api-Key)
# Generar con: php -r "echo bin2hex(random_bytes(32));"
ADMIN_API_KEY=
# UUID de un usuario admin existente: se usa como created_by del contenido
# creado via API
ADMIN_API_USER_ID=

TMDB_API_KEY=
