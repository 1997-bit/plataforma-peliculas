DB_HOST=localhost
DB_PORT=3306
DB_NAME=cineapp
DB_USER=root
DB_PASS=

# Clave de cifrado AES-256-GCM para defuse/php-encryption
# Generar con: php -r "echo \Defuse\Crypto\Key::createNewRandomKey()->saveToAsciiSafeString();"
APP_KEY=

# Clave HMAC-SHA256 para blind index de emails (min. 32 bytes aleatorios)
# Generar con: php -r "echo bin2hex(random_bytes(32));"
APP_HMAC_KEY=

SESSION_LIFETIME=3600
APP_DEBUG=false
APP_ENV=production

TMDB_API_KEY=